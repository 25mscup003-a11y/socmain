# Local IPS server configuration. Copy to .env and fill in shared settings.
IPS_WEBHOOK_PORT=5050

# Use the same MongoDB cluster as backend/.env.
# IPS records are stored in soc4_ips; MAIN_DB_NAME identifies the SOC database.
MONGO_URI=mongodb://127.0.0.1:27017/soc_saas
MAIN_DB_NAME=soc_saas

# Must match IPS_WEBHOOK_SECRET in backend/.env.
IPS_WEBHOOK_SECRET=
# Backend authority for all automatic network IP blocks; set its reachable URL when deployed separately.
SOC_BACKEND_URL=http://127.0.0.1:5000
IPS_FIREWALL_MODE=auto
IPS_BLOCK_TTL_HOURS=24
