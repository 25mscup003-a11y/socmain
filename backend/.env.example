# Local development. Run npm run setup:env to create .env with random secrets.
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/soc_saas

# These are generated by setup:env. Keep existing keys when restoring a setup.
JWT_SECRET=
AGENT_STORAGE_MASTER_KEY=

SERVER_PROTO=http
SERVER_IP=localhost
SERVER_PORT=5000
APP_PROTO=http
ROOT_DOMAIN=localhost
MAIN_TENANT_SUBDOMAIN=main
COMPANY_ORIGIN=http://localhost:3000
SUPERADMIN_ORIGIN=http://localhost:3001
