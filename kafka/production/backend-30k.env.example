# Merge these settings into the secured deployment environment.
# This is a sizing starting point, not a measured capacity guarantee.
INGESTION_MODE=broker
KAFKA_BROKERS=kafka-1.internal:9093,kafka-2.internal:9093,kafka-3.internal:9093
KAFKA_CLIENT_ID=ajnat-ingestion
KAFKA_SSL=true
KAFKA_SSL_REJECT_UNAUTHORIZED=true
KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.pem
KAFKA_SSL_CERT_FILE=/run/secrets/kafka-client.pem
KAFKA_SSL_KEY_FILE=/run/secrets/kafka-client-key.pem
KAFKA_LOG_LEVEL=warn

# Provision on a new production cluster; migrate existing topics deliberately.
BROKER_ALERT_TOPIC=soc.alerts.v1
BROKER_ALERT_RETRY_TOPIC=soc.alerts.retry.v1
BROKER_ALERT_DLQ_TOPIC=soc.alerts.dlq.v1
KAFKA_ALERT_PARTITIONS=96
KAFKA_RETRY_PARTITIONS=24
KAFKA_DLQ_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_RETENTION_MS=86400000
KAFKA_DLQ_RETENTION_MS=259200000

# Run API replicas and worker replicas separately under your process manager.
KAFKA_AUTO_START_WORKER=false
KAFKA_ALERT_GROUP_ID=soc-alert-storage-v1
KAFKA_PRODUCER_MAX_PENDING=128
KAFKA_PRODUCER_MAX_PENDING_BYTES=67108864
KAFKA_PUBLISH_WAIT_MS=15000
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_INITIAL_MS=300
KAFKA_RETRY_MAX_MS=30000
KAFKA_RETRY_ATTEMPTS=8

KAFKA_CONSUMER_PARTITION_CONCURRENCY=4
KAFKA_CONSUMER_MAX_PARTITION_BYTES=5242880
KAFKA_CONSUMER_MAX_BYTES=33554432
KAFKA_CONSUMER_MIN_BYTES=65536
KAFKA_CONSUMER_MAX_WAIT_MS=250
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=60000
KAFKA_CONSUMER_HEARTBEAT_MS=3000
KAFKA_CONSUMER_COMMIT_INTERVAL_MS=5000
BROKER_PERSIST_BATCH_SIZE=250
BROKER_MAX_RETRIES=8
BROKER_CORRELATION_DEBOUNCE_MS=30000
BROKER_SOAR_CONCURRENCY=8

# Per worker process; budget connections across all API and worker replicas.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
