# Apache Kafka 3.6+ KRaft broker. Copy per host; set unique id, host and rack.
process.roles=broker
node.id=1
broker.rack=zone-a
controller.quorum.voters=101@controller-1.internal:9094,102@controller-2.internal:9094,103@controller-3.internal:9094
controller.listener.names=CONTROLLER
listeners=BROKER://0.0.0.0:9093
advertised.listeners=BROKER://kafka-1.internal:9093
inter.broker.listener.name=BROKER
listener.security.protocol.map=BROKER:SSL,CONTROLLER:SSL

# PKCS#8 private key + certificate chain in broker.pem; private mounted files.
ssl.keystore.type=PEM
ssl.keystore.location=/run/secrets/broker.pem
ssl.truststore.type=PEM
ssl.truststore.location=/run/secrets/kafka-ca.pem
ssl.client.auth=required
ssl.enabled.protocols=TLSv1.3
ssl.endpoint.identification.algorithm=https
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
allow.everyone.if.no.acl.found=false
# Replace with exact certificate subject DNs if your CA uses additional fields.
super.users=User:CN=kafka-1;User:CN=kafka-2;User:CN=kafka-3;User:CN=controller-1;User:CN=controller-2;User:CN=controller-3;User:CN=kafka-admin

log.dirs=/var/lib/kafka/data
auto.create.topics.enable=false
num.partitions=96
default.replication.factor=3
min.insync.replicas=2
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
unclean.leader.election.enable=false
log.retention.hours=24
log.segment.bytes=536870912
log.cleanup.policy=delete
compression.type=producer
num.network.threads=8
num.io.threads=16
num.replica.fetchers=4
socket.send.buffer.bytes=1048576
socket.receive.buffer.bytes=1048576
socket.request.max.bytes=104857600
queued.max.requests=500
queued.max.request.bytes=67108864
message.max.bytes=10485760
replica.fetch.max.bytes=10485760
replica.fetch.response.max.bytes=33554432
group.initial.rebalance.delay.ms=3000
